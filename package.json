{
  "name": "zeno",
  "private": false,
  "version": "0.6.0",
  "type": "module",
  "description": "A clean, self-hosted comic reader — cross-platform PWA with pluggable sources",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZikiP/Zeno.git"
  },
  "homepage": "https://github.com/ZikiP/Zeno#readme",
  "bugs": {
    "url": "https://github.com/ZikiP/Zeno/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pwa",
    "reader",
    "comic",
    "comic-reader",
    "self-hosted",
    "offline",
    "typescript"
  ],
  "scripts": {
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "tsx scripts/gen-icons.ts",
    "test": "node scripts/run-tests.mjs",
    "test:whitelist": "node scripts/run-tests.mjs whitelist"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "lucide-react": "^1.57.0",
    "playwright-core": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-useanimations": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
