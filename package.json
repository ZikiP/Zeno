{
  "name": "manga-reader",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "跨端漫画阅读器（Android 手机 / 平板 / Web），无广告阅读体验",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
