{
  "name": "zeno",
  "private": false,
  "version": "0.6.0",
  "type": "module",
  "description": "干净的网页阅读器 — 跨端 PWA，内容源由用户自行配置",
  "license": "MIT",
  "keywords": [
    "pwa",
    "reader",
    "comic",
    "offline"
  ],
  "scripts": {
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "tsx scripts/gen-icons.ts",
    "test": "node scripts/run-tests.mjs",
    "test:whitelist": "node scripts/run-tests.mjs whitelist"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lucide-react": "^1.57.0",
    "playwright-core": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
